---
// Reader guide: a short first read and reading paths by interest. Data: src/data/paths.json.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import data from '../data/paths.json';
import { byId, lifespan, figureHref, partByN, href } from '../lib/graph.js';

const written = new Set((await getCollection('figures')).map((e) => e.id));
const all = [...data.firstRead, ...data.paths.flatMap((p) => p.steps)];
const missing = all.filter((s) => !written.has(s.id) || !byId[s.id]).map((s) => s.id);
if (missing.length) throw new Error(`src/data/paths.json names figures without a chapter file: ${[...new Set(missing)].join(', ')}`);

const meta = (id) => {
  const n = byId[id];
  const part = partByN[n.part];
  return `${lifespan(n)}${part ? ` · Part ${part.n}, ${part.title}` : ''}`;
};
---
<Base title="Start here" current="start" description="Five chapters for a first read, and reading paths through the book by interest.">
<main class="wrap">
  <div class="col">
    <span class="label">Reader's guide</span>
    <h1 style="font-size:clamp(2.2rem,6vw,3.6rem);margin:.4rem 0">Start here</h1>
    <p>The book is arranged in thirteen parts, each asking one question, and can be read straight through from the <a href={href('/')}>contents</a>. This page offers two shorter ways in. The first is five chapters that together give a sense of the whole book. The second is a set of reading paths, each following one interest across the parts in an order that makes sense on its own.</p>
    <p>Readers new to the subject may find the <a href={href('/prologue/')}>Prologue</a> useful first. It describes the older traditions that every modern teacher drew on, in about twenty minutes of reading.</p>

    <h2 id="first-read">A first read: five chapters</h2>
    <ol class="path">
      {data.firstRead.map((s) => (
        <li>
          <a href={figureHref(s.id)}>{byId[s.id].name}</a> <span class="meta">{meta(s.id)}</span>
          <p>{s.why}</p>
        </li>
      ))}
    </ol>

    <h2 id="paths">Reading paths</h2>
    <nav aria-label="Reading paths" class="path-index">
      <ul>
        {data.paths.map((p) => <li><a href={`#${p.slug}`}>{p.title}</a></li>)}
      </ul>
    </nav>

    {data.paths.map((p) => (
      <section aria-labelledby={p.slug}>
        <h3 id={p.slug}>{p.title}</h3>
        <p class="blurb">{p.blurb}</p>
        <ol class="path">
          {p.steps.map((s) => (
            <li>
              <a href={figureHref(s.id)}>{byId[s.id].name}</a> <span class="meta">{meta(s.id)}</span>
              <p>{s.why}</p>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <p style="margin-top:2.5rem">Any chapter's lineage diagram leads to the people before and after it, and the <a href={href('/tree/')}>tree</a> shows every connection at once. <a href={href('/about/')}>About this book</a> explains how the book was made and checked.</p>
  </div>
</main>
<style>
  .path{counter-reset:s;list-style:none;padding:0;margin:1rem 0 0}
  .path li{counter-increment:s;position:relative;padding:0 0 1rem 2.6rem;border-bottom:1px dotted var(--rule);margin-bottom:1rem}
  .path li::before{content:counter(s);position:absolute;left:0;top:-.15rem;font-family:var(--f-display);font-size:1.5rem;color:var(--flame);line-height:1.3}
  .path li > a{font-family:var(--f-display);font-size:1.2rem;text-decoration:none;color:var(--ink)}
  .path li > a:hover,.path li > a:focus-visible{color:var(--flame)}
  .path .meta{display:inline-block;font-family:var(--f-mono);font-size:.72rem;color:var(--muted);letter-spacing:.03em}
  .path p{margin:.25rem 0 0}
  .path-index ul{list-style:none;padding:0;margin:.5rem 0 0;display:flex;flex-wrap:wrap;gap:.5rem}
  .path-index a{display:inline-block;font-family:var(--f-mono);font-size:.78rem;text-decoration:none;border:1px solid var(--rule);background:var(--paper);padding:.3rem .6rem;color:var(--ink)}
  .path-index a:hover,.path-index a:focus-visible{border-color:var(--flame);color:var(--flame)}
  section h3{font-size:1.45rem;margin-top:2.6rem;scroll-margin-top:1rem}
  .blurb{color:var(--muted)}
</style>
</Base>
