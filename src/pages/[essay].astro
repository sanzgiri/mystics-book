---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Banyan from '../components/art/Banyan.astro';
import MiniTree from '../components/MiniTree.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((e) => ({ params: { essay: e.id }, props: { entry: e } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const kicker = entry.id === 'prologue' ? 'Prologue' : entry.id === 'epilogue' ? 'Epilogue' : 'Essay';
---
<Base title={entry.data.title} description={entry.data.subtitle}>
<main class="wrap" data-pagefind-body>
  <header class="hero">
    <div>
      <span class="label">{kicker}</span>
      <h1>{entry.data.title}</h1>
      {entry.data.subtitle && <p class="sub">{entry.data.subtitle}</p>}
      <p><span class={`status ${entry.data.status}`}>{entry.data.status}</span></p>
    </div>
    <Banyan />
  </header>
  <div class="chapter">
    <Content components={{ MiniTree }} />
  </div>
</main>
</Base>
