---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Banyan from '../components/art/Banyan.astro';
import MiniTree from '../components/MiniTree.astro';
import CorrectionLink from '../components/CorrectionLink.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((e) => ({ params: { essay: e.id }, props: { entry: e } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const KICKER = { prologue: 'Prologue', epilogue: 'Epilogue', about: 'About' };
const kicker = KICKER[entry.id] || 'Essay';
const showStatus = entry.id !== 'about';
---
<Base title={entry.data.title} description={entry.data.subtitle} current={entry.id === 'about' ? 'about' : ''}>
<main class="wrap" data-pagefind-body>
  <header class="hero">
    <div>
      <span class="label">{kicker}</span>
      <h1>{entry.data.title}</h1>
      {entry.data.subtitle && <p class="sub">{entry.data.subtitle}</p>}
      {showStatus && <p>{entry.data.status !== 'final' && <span class={`status ${entry.data.status}`}>{entry.data.status}</span>}</p>}
    </div>
    <Banyan />
  </header>
  <div class="chapter">
    <Content components={{ MiniTree, CorrectionLink }} />
  </div>
</main>
</Base>
