---
// Licence, credits and data sources. Licence names live in src/data/site.json (author's choice);
// image and audio credits live in src/data/credits.json; chapter portraits are read from frontmatter.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import credits from '../data/credits.json';
import { byId, figureHref, href } from '../lib/graph.js';

const portraits = (await getCollection('figures'))
  .filter((e) => e.data.photo)
  .map((e) => ({
    kind: 'image', title: `Portrait: ${byId[e.id]?.name || e.id}`, creator: e.data.photo.credit,
    sourceUrl: e.data.photo.sourceUrl, license: e.data.photo.license, usedOn: figureHref(e.id),
  }));
const items = [...credits.items, ...portraits].sort((a, b) => a.title.localeCompare(b.title));
const { text, code } = site.license;
---
<Base title="Credits and licence" current="credits" description="The licence for the text and code, image and audio credits, and the data and software the book is built on.">
<main class="wrap">
  <div class="col">
    <span class="label">Companion</span>
    <h1 style="font-size:clamp(2.2rem,6vw,3.6rem);margin:.4rem 0">Credits and licence</h1>

    <h2>Licence for the text</h2>
    <p>The author has chosen to publish the text of {site.title} under the <a href={text.url} rel="license">{text.name}</a> licence ({text.short}). Anyone may copy, share and adapt the text, including for commercial use, provided they credit the book, link to the licence, say whether they made changes, and release any adapted text under the same licence.</p>
    <p>A suggested credit line: <i>{site.title}: {site.subtitle}</i>, {new URL('/', Astro.site).href.replace(/\/$/, '')}, {text.short}.</p>
    <p>Quotations from the figures and from other authors remain the property of their rights holders and are quoted briefly for discussion. Images and recordings listed below keep their own licences.</p>

    <h2>Licence for the code</h2>
    <p>The software that builds the site (layouts, components, scripts and styles) is released under the <a href={code.url}>{code.name}</a>. The source is public at <a href={site.repo}>{site.repo.replace('https://', '')}</a>.</p>

    <h2>Images and audio</h2>
    {items.length ? (
      <ul class="credits">
        {items.map((c) => (
          <li>
            <span class="kind">{c.kind}</span>
            <span><a href={c.sourceUrl}>{c.title}</a>{c.creator && <>, {c.creator}</>}. {c.licenseUrl ? <a href={c.licenseUrl}>{c.license}</a> : c.license}.{c.usedOn && <> Used on <a href={href(c.usedOn)}>{c.usedOn}</a>.</>}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p>The illustrations in the book are original drawings made for it. The book currently uses no third-party images or recordings. Audio and video are linked to their rights holders, such as ashrams, archives and official channels, and are hosted by them.</p>
    )}

    <h2>Data sources</h2>
    <ul>
      <li><strong>Lineage tree, timeline and places.</strong> Compiled for this book from the sources cited in each chapter. The <a href={href('/about/')}>About page</a> explains the evidence grades and the verified flag.</li>
      <li><strong>Map tiles.</strong> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>, under the Open Database License, displayed with <a href="https://leafletjs.com">Leaflet</a>.</li>
      <li><strong>Chapter sources.</strong> Each chapter and profile lists its own references or further reading. General works are on the <a href={href('/sources/')}>Sources</a> page.</li>
    </ul>

    <h2>Software and fonts</h2>
    <ul>
      <li>Built with <a href="https://astro.build">Astro</a> and MDX (MIT).</li>
      <li>Lineage graph drawn with <a href="https://js.cytoscape.org">Cytoscape.js</a> and cytoscape-dagre (MIT).</li>
      <li>Map with <a href="https://leafletjs.com">Leaflet</a> (BSD 2-Clause).</li>
      <li>Search with <a href="https://pagefind.app">Pagefind</a> (MIT).</li>
      <li>Type set in Young Serif, Literata, IBM Plex Mono and the Noto Serif families, served by Google Fonts under the SIL Open Font License.</li>
    </ul>
  </div>
</main>
<style>
  .credits{list-style:none;padding:0}
  .credits li{display:grid;grid-template-columns:4.5rem minmax(0,1fr);gap:.8rem;padding:.5rem 0;border-bottom:1px dotted var(--rule)}
  .credits .kind{font-family:var(--f-mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--flame);padding-top:.3rem}
</style>
</Base>
