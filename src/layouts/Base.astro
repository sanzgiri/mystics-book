---
import '../styles/global.css';
import site from '../data/site.json';
import { href, correctionUrl } from '../lib/graph.js';
const { title, description = site.subtitle, current = '', image = '/og.png', imageAlt = `${site.title}: a banyan tree beside the title and subtitle`, type } = Astro.props;
const nav = [
  ['contents', 'Contents', '/'],
  ['start', 'Paths', '/start/'],
  ['tree', 'Tree', '/tree/'],
  ['timeline', 'Timeline', '/timeline/'],
  ['map', 'Map', '/map/'],
  ['glossary', 'Glossary', '/glossary/'],
  ['appendix', 'Appendix', '/appendix/'],
  ['search', 'Search', '/search/'],
  ['about', 'About', '/about/'],
];
const foot = [
  ['About this book', '/about/'],
  ['Start here', '/start/'],
  ['Appendix', '/appendix/'],
  ['Sources', '/sources/'],
  ['Credits and licence', '/credits/'],
  ['Changelog', '/changelog/'],
  ['Progress', '/status/'],
];
const fullTitle = title ? `${title} · ${site.title}` : `${site.title}: ${site.subtitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(href(image), Astro.site).href;
const ogType = type || (Astro.url.pathname === '/' || Astro.url.pathname === href('/') ? 'website' : 'article');
const fix = correctionUrl(title || site.title, canonical);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {!site.launched && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={canonical}>
  <meta property="og:site_name" content={site.title}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={imageAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={imageAlt}>
  <link rel="license" href={site.license.text.url}>
  <link rel="sitemap" href={href('/sitemap-index.xml')}>
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=IBM+Plex+Mono:wght@400;500&family=Noto+Serif+Tamil:wght@400;600&family=Noto+Serif+Devanagari:wght@400;600&family=Noto+Naskh+Arabic&display=swap">
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="site">
    <a class="brand" href={href('/')}>{site.title}</a>
    <nav aria-label="Book">
      {nav.map(([key, label, path]) => (
        <a href={href(path)} aria-current={current === key ? 'page' : undefined}>{label}</a>
      ))}
      <button class="theme-btn" id="theme-btn" type="button" aria-label="Switch light or dark theme">Theme</button>
    </nav>
  </header>
  <div id="content" tabindex="-1">
    <slot />
  </div>
  <footer class="site-foot">
    <p>{site.title}: {site.subtitle}. A free web book. Text under <a href={site.license.text.url} rel="license">{site.license.text.short}</a>, code under {site.license.code.short}.</p>
    <nav aria-label="About the book">
      {foot.map(([label, path]) => <a href={href(path)}>{label}</a>)}
      <a href={fix}>Report a correction</a>
    </nav>
  </footer>
  <script is:inline>
    document.getElementById('theme-btn')?.addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
    });
  </script>
</body>
</html>
