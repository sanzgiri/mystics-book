---
import '../styles/global.css';
import site from '../data/site.json';
import { href } from '../lib/graph.js';
const { title, description = site.subtitle, current = '' } = Astro.props;
const nav = [
  ['contents', 'Contents', '/'],
  ['tree', 'Tree', '/tree/'],
  ['timeline', 'Timeline', '/timeline/'],
  ['map', 'Map', '/map/'],
  ['glossary', 'Glossary', '/glossary/'],
  ['sources', 'Sources', '/sources/'],
  ['search', 'Search', '/search/'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title ? `${title} · ${site.title}` : site.title}</title>
  <meta name="description" content={description}>
  {!site.launched && <meta name="robots" content="noindex, nofollow">}
  <meta property="og:title" content={title ? `${title} · ${site.title}` : site.title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="article">
  <meta property="og:image" content={new URL('/og.png', Astro.site).href}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="sitemap" href={href('/sitemap-index.xml')}>
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=IBM+Plex+Mono:wght@400;500&family=Noto+Serif+Tamil:wght@400;600&family=Noto+Serif+Devanagari:wght@400;600&family=Noto+Naskh+Arabic&display=swap">
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <slot name="head" />
</head>
<body>
  <header class="site">
    <a class="brand" href={href('/')}>{site.title}</a>
    <nav aria-label="Book">
      {nav.map(([key, label, path]) => (
        <a href={href(path)} aria-current={current === key ? 'page' : undefined}>{label}</a>
      ))}
      <button class="theme-btn" id="theme-btn" type="button" aria-label="Switch light or dark theme">Theme</button>
    </nav>
  </header>
  <slot />
  <footer class="site-foot">
    {site.title}: {site.subtitle}. A work in progress; chapters marked Draft are unreviewed. <a href={href("/status/")}>Progress</a>
  </footer>
  <script is:inline>
    document.getElementById('theme-btn')?.addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
    });
  </script>
</body>
</html>
