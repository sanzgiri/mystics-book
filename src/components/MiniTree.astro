---
// Auto-drawn neighborhood of one figure: who shaped them (above) and whom they shaped (below).
import { byId, parentsOf, childrenOf, lifespan, hasPage, figureHref, EDGE_LABEL } from '../lib/graph.js';
const { id } = Astro.props;
const me = byId[id];
const parents = parentsOf(id);
const children = childrenOf(id);

const W = 196, H = 46, GX = 14, GY = 70, PER_ROW = 4;
const rows = (arr) => { const r = []; for (let i = 0; i < arr.length; i += PER_ROW) r.push(arr.slice(i, i + PER_ROW)); return r; };
const pRows = rows(parents), cRows = rows(children);
const maxCols = Math.max(1, ...pRows.map((r) => r.length), ...cRows.map((r) => r.length));
const width = maxCols * W + (maxCols - 1) * GX + 20;
const rowX = (n, i) => (width - (n * W + (n - 1) * GX)) / 2 + i * (W + GX);

let y = 10;
const placed = [];
pRows.forEach((r) => { r.forEach((p, i) => placed.push({ ...p, x: rowX(r.length, i), y, dir: 'up' })); y += H + 24; });
if (pRows.length) y += GY - 24;
const meX = rowX(1, 0), meY = y; y += H + GY;
cRows.forEach((r) => { r.forEach((c, i) => placed.push({ ...c, x: rowX(r.length, i), y, dir: 'down' })); y += H + 24; });
const height = y - 14;

const personal = new Set(['initiated', 'lived-with', 'protected']);
const stroke = (t) => (t === 'claimed' ? 'var(--muted)' : personal.has(t) ? 'var(--flame)' : 'var(--indigo)');
const dash = (ev) => (ev === 'testimony' ? '6 4' : ev === 'hagiographic' || ev === 'devotional' ? '1.5 4' : 'none');
const short = (s, n = 26) => (s.length > n ? s.slice(0, n - 1) + '…' : s);
const path = (p) => {
  if (p.dir === 'up') {
    const x1 = p.x + W / 2, y1 = p.y + H, x2 = meX + W / 2, y2 = meY;
    return `M${x1} ${y1} C${x1} ${(y1 + y2) / 2} ${x2} ${(y1 + y2) / 2} ${x2} ${y2 - 2}`;
  }
  const x1 = meX + W / 2, y1 = meY + H, x2 = p.x + W / 2, y2 = p.y;
  return `M${x1} ${y1} C${x1} ${(y1 + y2) / 2} ${x2} ${(y1 + y2) / 2} ${x2} ${y2 - 2}`;
};
---
{me && (
<figure class="minitree" aria-label={`Lineage of ${me.name}`}>
  <svg viewBox={`0 0 ${width} ${height}`} width={width} role="img" aria-label={`Influences on ${me.name} above, people they shaped below`}>
    <defs>
      <marker id={`ah-${id}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="var(--muted)"/></marker>
    </defs>
    {placed.map((p) => (
      <path d={path(p)} fill="none" stroke={stroke(p.edge.type)} stroke-width="1.6" stroke-dasharray={dash(p.edge.evidence)} stroke-linecap="round" opacity={p.edge.verified ? 1 : 0.45} marker-end={`url(#ah-${id})`}>
        <title>{`${p.dir === 'up' ? p.node.name + ' → ' + me.name : me.name + ' → ' + p.node.name}: ${EDGE_LABEL[p.edge.type] || p.edge.type} (${p.edge.evidence})${p.edge.note ? '. ' + p.edge.note : ''}${p.edge.verified ? '' : ' [draft]'}`}</title>
      </path>
    ))}
    {placed.map((p) => {
      const link = hasPage(p.node) ? figureHref(p.node.id) : null;
      const box = (
        <g>
          <rect x={p.x} y={p.y} width={W} height={H} rx="3" fill={p.node.tier === 'root' ? 'var(--bg)' : 'var(--paper)'} stroke="var(--rule)"/>
          <text x={p.x + 10} y={p.y + 20} font-family="var(--f-body)" font-size="13" fill="var(--ink)">{short(p.node.name)}</text>
          <text x={p.x + 10} y={p.y + 36} font-family="var(--f-mono)" font-size="10" fill="var(--muted)">{short(`${EDGE_LABEL[p.edge.type] || p.edge.type}${lifespan(p.node) ? ' · ' + lifespan(p.node) : ''}`, 32)}</text>
        </g>
      );
      return link ? <a href={link}>{box}</a> : box;
    })}
    <g>
      <rect x={meX} y={meY} width={W} height={H} rx="3" fill="var(--flame-soft)" stroke="var(--flame)" stroke-width="1.5"/>
      <text x={meX + 10} y={meY + 22} font-family="var(--f-display)" font-size="15" fill="var(--ink)">{short(me.name, 22)}</text>
      <text x={meX + 10} y={meY + 38} font-family="var(--f-mono)" font-size="10" fill="var(--muted)">{lifespan(me)}</text>
    </g>
    {placed.length === 0 && <text x={width / 2} y={meY + H + 30} text-anchor="middle" font-family="var(--f-mono)" font-size="11" fill="var(--muted)">No edges drawn yet</text>}
  </svg>
  <div class="legend">
    <span><svg width="34" height="8" viewBox="0 0 34 8"><line x1="0" y1="4" x2="34" y2="4" stroke="var(--indigo)" stroke-width="2"/></svg>influence, lineage, family</span>
    <span><svg width="34" height="8" viewBox="0 0 34 8"><line x1="0" y1="4" x2="34" y2="4" stroke="var(--flame)" stroke-width="2"/></svg>initiated / lived with</span>
    <span><svg width="34" height="8" viewBox="0 0 34 8"><line x1="0" y1="4" x2="34" y2="4" stroke="var(--muted)" stroke-width="2"/></svg>documented</span>
    <span><svg width="34" height="8" viewBox="0 0 34 8"><line x1="0" y1="4" x2="34" y2="4" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 4"/></svg>testimony</span>
    <span><svg width="34" height="8" viewBox="0 0 34 8"><line x1="0" y1="4" x2="34" y2="4" stroke="var(--muted)" stroke-width="2" stroke-dasharray="1.5 4" stroke-linecap="round"/></svg>legendary / devotional</span>
    <span><svg width="34" height="8" viewBox="0 0 34 8"><line x1="0" y1="4" x2="34" y2="4" stroke="var(--indigo)" stroke-width="2" opacity=".45"/></svg>faded = not yet verified</span>
  </div>
</figure>
)}
