---
// Generic illustration: a banyan, trunk and aerial roots. Used where a figure has no art yet, and on the cover.
const { label = 'Illustration: a banyan tree with many aerial roots' } = Astro.props;
---
<svg viewBox="0 0 480 300" role="img" aria-label={label}>
  <rect x="0" y="0" width="480" height="300" fill="var(--flame-soft)" opacity=".45"/>
  <g fill="none" stroke="var(--ink)" stroke-linecap="round" opacity=".8">
    <path d="M240 300 C238 250 236 210 240 170" stroke-width="10"/>
    <path d="M240 175 C210 150 160 130 90 128" stroke-width="5"/>
    <path d="M240 175 C270 150 320 130 390 128" stroke-width="5"/>
    <path d="M240 172 C232 140 230 110 236 80" stroke-width="4"/>
    <path d="M160 133 C158 180 156 240 158 300" stroke-width="1.6"/>
    <path d="M120 129 C121 190 119 250 122 300" stroke-width="1.2"/>
    <path d="M320 133 C322 180 324 240 322 300" stroke-width="1.6"/>
    <path d="M360 130 C359 190 361 250 358 300" stroke-width="1.2"/>
    <path d="M200 148 C199 200 197 250 200 300" stroke-width="1"/>
    <path d="M285 146 C286 200 288 250 284 300" stroke-width="1"/>
  </g>
  <g fill="var(--hill-2)" opacity=".55">
    <ellipse cx="110" cy="112" rx="70" ry="34"/>
    <ellipse cx="370" cy="112" rx="70" ry="34"/>
    <ellipse cx="240" cy="70" rx="90" ry="44"/>
    <ellipse cx="175" cy="100" rx="60" ry="30"/>
    <ellipse cx="305" cy="100" rx="60" ry="30"/>
  </g>
  <circle cx="240" cy="70" r="4" fill="var(--flame)"/>
</svg>
